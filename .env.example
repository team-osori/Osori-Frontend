# 이 파일을 .env.local로 복사해서 값을 채웁니다.
# .env.local은 커밋하지 않습니다. 서버 주소는 공개 저장소에 적지 말고 팀 내부에서 공유받으세요.

# API 주소. 비워 두면 같은 출처의 /api로 요청하고, 개발 서버 프록시가 백엔드로 넘깁니다.
# 배포할 때만 넣습니다.
VITE_API_BASE_URL=

# 개발 서버 프록시가 /api 요청을 넘길 백엔드 주소 (예: http://<백엔드 주소>)
# npm run api:types도 이 주소의 /openapi.json으로 타입을 만듭니다.
VITE_API_PROXY_TARGET=
